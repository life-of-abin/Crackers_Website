generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id                 Int           @id @default(autoincrement())
  name               String
  email              String        @unique
  phone              String
  passwordHash       String
  role               String        @default("CUSTOMER")
  status             String        @default("ACTIVE")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  addresses          Address[]
  orders             Order[]

  @@index([email])
  @@index([phone])
}

model Address {
  id           Int       @id @default(autoincrement())
  userId       Int
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  icon        String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  categoryId  Int?
  price       Decimal
  mrp         Decimal
  discount    String?
  hsnCode     String?
  taxRate     Decimal?    @default(18)
  quantity    String      @default("10 Pieces")
  unitType    String      @default("BOX") // BOX, PACK, BUNDLE, UNIT
  packSize    String      @default("10 Pieces")
  image       String?
  badge       String?
  purchases   Int         @default(0)
  stock       Int         @default(100) // Sellable units (boxes/packs)
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]

  @@index([name])
  @@index([categoryId])
  @@index([active])
  @@index([stock])
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int?
  customerName  String
  phone         String
  email         String?
  address       String
  landmark      String?
  city          String
  district      String?
  state         String
  pincode       String
  billingAddress String?
  billingCity    String?
  billingState   String?
  billingPincode String?
  customerGstin  String?
  placeOfSupply  String?
  invoiceNumber       String?     @unique
  subtotal            Decimal     @default(0)
  discount            Decimal     @default(0)
  shipping            Decimal     @default(0)
  totalAmount         Decimal
  orderType           String      @default("DELIVERY") // DELIVERY, PICKUP, OFFLINE
  orderSource         String      @default("ONLINE")   // ONLINE, OFFLINE
  offlineBillNumber   String?     @unique
  deliveryCharge      Decimal     @default(0) // Set by admin for DELIVERY orders
  deliveryConfirmed   Boolean     @default(false) // Admin confirms delivery charge
  invoiceGeneratedAt  DateTime?   // When invoice was first locked/generated
  paymentStatus       String      @default("PENDING_PAYMENT")
  paymentMethod       String?
  orderStatus         String      @default("PLACED") // PLACED, AWAITING_DELIVERY_CONFIRMATION, CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, READY_FOR_PICKUP, COLLECTED, CANCELLED, FAILED
  paymentId           String?
  paidAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]

  @@index([phone])
  @@index([email])
  @@index([paymentStatus])
  @@index([orderSource])
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  quantity    Int       // Number of boxes/packs
  unitType    String?   @default("BOX")
  packSize    String?   @default("10 Pieces")
  price       Decimal
  total       Decimal
  hsnCode     String?
  taxRate     Decimal?    @default(18)
  taxableValue Decimal?
  cgstAmount  Decimal?
  sgstAmount  Decimal?
  igstAmount  Decimal?

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Payment {
  id                Int      @id @default(autoincrement())
  orderId           Int
  paymentMethod     String?
  paymentRef        String?
  amount            Decimal
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentAccount {
  id            Int      @id @default(autoincrement())
  type          String
  displayName   String
  upiId         String?
  qrImage       String?
  bankName      String?
  accountHolder String?
  accountNumber String?
  ifsc          String?
  branch        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminEmail String
  action     String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Settings {
  id                   Int      @id @default(1)
  storeName            String   @default("Sri Sivakasi Crackers")
  phone                String   @default("9629525907")
  email                String   @default("abinesh.ece200@gmail.com")
  address              String   @default("123 Main Bazaar, Sivakasi, Tamil Nadu 626123")
  googleMapsUrl        String   @default("https://maps.google.com/?q=Sivakasi,Tamil+Nadu")
  whatsappNumber       String   @default("+919629525907")
  minOrderAmount       Decimal  @default(500)
  flatShippingFee      Decimal  @default(100)
  freeShippingThreshold Decimal @default(3000)
  gstin                String?
  legalName            String?
  invoiceTerms         String?
  isGstRegistered      Boolean  @default(false)
  signatureImage       String?
  updatedAt            DateTime @updatedAt
}